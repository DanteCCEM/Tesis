# Copia este archivo a .env en la raíz del proyecto para docker compose.
# cp .env.example .env   (Linux/macOS)
# copy .env.example .env (Windows)

# Seguridad (cambia en producción)
JWT_SECRET=cambiar-este-secreto-en-produccion
JWT_EXPIRES_IN=1d

# Google Gemini (obligatorio para generar preguntas, retroalimentación y planes con IA)
# Crea una clave en https://aistudio.google.com/apikey y pégala aquí, sin comillas.
# Docker Compose lee este archivo de la RAÍZ del proyecto (no solo backend/.env).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash
GEMINI_RETRY_MAX=3
GEMINI_RETRY_BASE_MS=1500

# URL del API que usará el navegador al abrir el frontend
VITE_API_URL=http://localhost:3000/api

# Origen permitido por CORS del backend (URL del frontend en el navegador)
CORS_ORIGIN=http://localhost:8080

# Ejecutar seed demo al arrancar el backend (true/false). Se recomienda false.
RUN_SEED=false

# Bootstrap opcional del primer administrador (solo lo usa el seed manual).
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NOMBRES=Administrador
ADMIN_CORREO=
