// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===================== ENUMS =====================

enum Rol {
  ADMIN
  DOCENTE
  ESTUDIANTE
}

enum EstadoUsuario {
  ACTIVO
  BLOQUEADO
  INACTIVO
}

enum NivelDificultad {
  BASICO
  INTERMEDIO
  AVANZADO
}

enum EstadoEvaluacion {
  BORRADOR
  PUBLICADA
  CERRADA
  ARCHIVADA
}

enum TipoEvaluacion {
  REGULAR
  DIAGNOSTICA
  FORMATIVA_ADAPTATIVA
  FINAL
  PRACTICA_ADAPTATIVA
}

enum TipoPregunta {
  OPCION_MULTIPLE
  VERDADERO_FALSO
  RESPUESTA_CORTA
}

enum EstadoIntento {
  EN_PROGRESO
  FINALIZADO
}

enum NivelVarianteEvaluacion {
  COMUN
  BASICO
  INTERMEDIO
  AVANZADO
}

enum EstadoVarianteEvaluacion {
  BORRADOR
  APROBADA
  PUBLICADA
  NO_DISPONIBLE
}

enum EstadoPracticaAdaptativa {
  PENDIENTE
  EN_CURSO
  COMPLETADA
}

enum PeriodoCurricular {
  SEMESTRE
  BIMESTRE
  TRIMESTRE
}

enum EstadoPlanCurricular {
  BORRADOR
  PUBLICADO
}

enum EstadoTemaCurricular {
  PENDIENTE
  EN_PROCESO
  COMPLETADO
}

enum EstadoAnioAcademico {
  ACTIVO
  CERRADO
}

enum EstadoRegistroAcademico {
  ACTIVO
  INACTIVO
}

// ===================== MODELOS =====================

model Usuario {
  id                   Int           @id @default(autoincrement())
  username             String        @unique
  nombres              String
  correo               String?       @unique
  contrasena           String // almacenada cifrada (bcrypt)
  rol                  Rol
  estado               EstadoUsuario @default(ACTIVO)
  debeCambiarPassword  Boolean       @default(true)
  sessionVersion       Int           @default(0)
  ultimoAcceso         DateTime?
  fotoPerfil           String?
  telefono             String?
  institucionEducativa String?
  biografiaCorta       String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  // Relaciones como DOCENTE
  cursos       Curso[]
  evaluaciones Evaluacion[]
  variantesAprobadas VarianteEvaluacion[] @relation("VarianteAprobador")
  calificacionesModificadas IntentoEvaluacion[] @relation("CalificacionModificada")

  // Relaciones como ESTUDIANTE
  matriculas             Matricula[]
  intentos               IntentoEvaluacion[]
  progresos              ProgresoEstudiante[]
  historialProgreso      HistorialProgreso[]
  practicasAdaptativas   PracticaAdaptativa[]
  evaluacionesObjetivo   Evaluacion[]         @relation("PracticasObjetivo")
  auditoriasComoActor    Auditoria[]          @relation("AuditoriaActor")
  auditoriasComoObjetivo Auditoria[]          @relation("AuditoriaObjetivo")
  perfilDocente          PerfilDocente?
  perfilEstudiante       PerfilEstudiante?
  asignacionesDocente    AsignacionCurso[]
  matriculasAcademicas   MatriculaAcademica[]
}

model Auditoria {
  id                Int      @id @default(autoincrement())
  usuarioActorId    Int
  usuarioObjetivoId Int?
  accion            String
  datos             Json?
  createdAt         DateTime @default(now())

  usuarioActor    Usuario  @relation("AuditoriaActor", fields: [usuarioActorId], references: [id], onDelete: Restrict)
  usuarioObjetivo Usuario? @relation("AuditoriaObjetivo", fields: [usuarioObjetivoId], references: [id], onDelete: SetNull)

  @@index([usuarioActorId, createdAt])
  @@index([usuarioObjetivoId, createdAt])
  @@index([accion, createdAt])
}

model Curso {
  id          Int      @id @default(autoincrement())
  nombre      String
  grado       String
  seccion     String
  descripcion String?
  createdAt   DateTime @default(now())

  asignacionCursoId Int?             @unique
  asignacionCurso   AsignacionCurso? @relation(fields: [asignacionCursoId], references: [id], onDelete: SetNull)

  docenteId Int
  docente   Usuario @relation(fields: [docenteId], references: [id])

  matriculas           Matricula[]
  evaluaciones         Evaluacion[]
  progresos            ProgresoEstudiante[]
  practicasAdaptativas PracticaAdaptativa[]
  planesCurriculares   PlanCurricular[]
}

model AnioAcademico {
  id          Int                 @id @default(autoincrement())
  anio        Int                 @unique
  estado      EstadoAnioAcademico @default(ACTIVO)
  fechaInicio DateTime?
  fechaFin    DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  asignaciones AsignacionCurso[]
  matriculas   MatriculaAcademica[]
  evaluaciones Evaluacion[]
}

model Grado {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique
  orden     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  secciones Seccion[]

  @@index([orden])
}

model Seccion {
  id        Int                     @id @default(autoincrement())
  gradoId   Int
  nombre    String
  estado    EstadoRegistroAcademico @default(ACTIVO)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  grado     Grado                   @relation(fields: [gradoId], references: [id], onDelete: Restrict)

  asignaciones AsignacionCurso[]
  matriculas   MatriculaAcademica[]

  @@unique([gradoId, nombre])
}

model AreaCurricular {
  id          Int                     @id @default(autoincrement())
  nombre      String                  @unique
  descripcion String?
  estado      EstadoRegistroAcademico @default(ACTIVO)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  asignaciones AsignacionCurso[]
}

model PerfilDocente {
  id              Int      @id @default(autoincrement())
  usuarioId       Int      @unique
  dni             String   @unique
  nombres         String
  apellidoPaterno String
  apellidoMaterno String
  telefono        String?
  especialidad    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  usuario         Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model PerfilEstudiante {
  id               Int       @id @default(autoincrement())
  usuarioId        Int       @unique
  codigoEstudiante String?   @unique
  dni              String    @unique
  nombres          String
  apellidoPaterno  String
  apellidoMaterno  String
  telefono         String?
  fechaNacimiento  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  usuario          Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model AsignacionCurso {
  id               Int                     @id @default(autoincrement())
  areaCurricularId Int
  seccionId        Int
  docenteId        Int
  anioAcademicoId  Int
  estado           EstadoRegistroAcademico @default(ACTIVO)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  areaCurricular   AreaCurricular          @relation(fields: [areaCurricularId], references: [id], onDelete: Restrict)
  seccion          Seccion                 @relation(fields: [seccionId], references: [id], onDelete: Restrict)
  docente          Usuario                 @relation(fields: [docenteId], references: [id], onDelete: Restrict)
  anioAcademico    AnioAcademico           @relation(fields: [anioAcademicoId], references: [id], onDelete: Restrict)
  cursoLegacy       Curso?
  progresos         ProgresoEstudiante[]
  historialProgreso HistorialProgreso[]

  @@unique([areaCurricularId, seccionId, anioAcademicoId])
  @@index([docenteId, anioAcademicoId])
}

model MatriculaAcademica {
  id              Int                     @id @default(autoincrement())
  estudianteId    Int
  seccionId       Int
  anioAcademicoId Int
  estado          EstadoRegistroAcademico @default(ACTIVO)
  fechaMatricula  DateTime                @default(now())
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  estudiante      Usuario                 @relation(fields: [estudianteId], references: [id], onDelete: Restrict)
  seccion         Seccion                 @relation(fields: [seccionId], references: [id], onDelete: Restrict)
  anioAcademico   AnioAcademico           @relation(fields: [anioAcademicoId], references: [id], onDelete: Restrict)

  @@unique([estudianteId, anioAcademicoId])
  @@index([seccionId, anioAcademicoId])
}

model Matricula {
  id             Int      @id @default(autoincrement())
  fechaMatricula DateTime @default(now())

  estudianteId Int
  estudiante   Usuario @relation(fields: [estudianteId], references: [id])

  cursoId Int
  curso   Curso @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@unique([estudianteId, cursoId])
}

model Evaluacion {
  id                   Int              @id @default(autoincrement())
  titulo               String
  tema                 String
  subtema              String?
  nivelDificultad      NivelDificultad
  fechaLimite          DateTime?
  estado               EstadoEvaluacion @default(BORRADOR)
  tipoEvaluacion         TipoEvaluacion    @default(REGULAR)
  esAdaptativa           Boolean           @default(false)
  configuracionAdaptativa Json?
  esPracticaAdaptativa   Boolean           @default(false)
  estudianteObjetivoId   Int?
  anioAcademicoId        Int?
  temaCurricularId       Int?
  subtemaCurricularId    Int?
  createdAt              DateTime          @default(now())

  cursoId Int
  curso   Curso @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  docenteId Int
  docente   Usuario @relation(fields: [docenteId], references: [id])

  estudianteObjetivo Usuario?           @relation("PracticasObjetivo", fields: [estudianteObjetivoId], references: [id])
  anioAcademico      AnioAcademico?     @relation(fields: [anioAcademicoId], references: [id], onDelete: SetNull)
  temaCurricular     TemaCurricular?    @relation(fields: [temaCurricularId], references: [id], onDelete: SetNull)
  subtemaCurricular  SubtemaCurricular? @relation(fields: [subtemaCurricularId], references: [id], onDelete: SetNull)

  preguntas          Pregunta[]
  variantesEvaluacion VarianteEvaluacion[]
  intentos           IntentoEvaluacion[]
  practicaAdaptativa PracticaAdaptativa?
  historialProgreso  HistorialProgreso[]

  @@index([cursoId, tipoEvaluacion])
  @@index([anioAcademicoId, tipoEvaluacion])
}

model Pregunta {
  id                Int             @id @default(autoincrement())
  enunciado         String
  tipo              TipoPregunta
  dificultad        NivelDificultad
  tema              String
  respuestaCorrecta String?
  puntaje           Float           @default(1)
  generadaPorIA     Boolean         @default(false)
  fechaGeneracion   DateTime?
  modeloGeneracion  String?
  revisadaPorDocente Boolean        @default(false)
  fechaRevision     DateTime?
  nivelVariante     NivelVarianteEvaluacion?

  evaluacionId Int
  evaluacion   Evaluacion @relation(fields: [evaluacionId], references: [id], onDelete: Cascade)

  varianteEvaluacionId Int?
  varianteEvaluacion   VarianteEvaluacion? @relation(fields: [varianteEvaluacionId], references: [id], onDelete: SetNull)

  alternativas Alternativa[]
  respuestas   RespuestaEstudiante[]
}

model VarianteEvaluacion {
  id                    Int                     @id @default(autoincrement())
  evaluacionId          Int
  nivelObjetivo         NivelVarianteEvaluacion
  cantidadPreguntas     Int
  dificultadPredominante NivelDificultad?
  estado                EstadoVarianteEvaluacion @default(BORRADOR)
  fechaAprobacion       DateTime?
  docenteAprobadorId    Int?
  createdAt             DateTime                @default(now())

  evaluacion            Evaluacion @relation(fields: [evaluacionId], references: [id], onDelete: Cascade)
  docenteAprobador      Usuario?   @relation("VarianteAprobador", fields: [docenteAprobadorId], references: [id], onDelete: SetNull)
  preguntas             Pregunta[]
  intentos              IntentoEvaluacion[]

  @@unique([evaluacionId, nivelObjetivo])
  @@index([evaluacionId, estado])
}

model Alternativa {
  id         Int     @id @default(autoincrement())
  texto      String
  esCorrecta Boolean @default(false)

  preguntaId Int
  pregunta   Pregunta @relation(fields: [preguntaId], references: [id], onDelete: Cascade)

  respuestas RespuestaEstudiante[]
}

model IntentoEvaluacion {
  id                  Int              @id @default(autoincrement())
  fechaInicio         DateTime         @default(now())
  fechaFin            DateTime?
  puntajeTotal        Float            @default(0)
  porcentaje          Float            @default(0)
  nota                Float            @default(0)
  puntajeAutomatico   Float            @default(0)
  porcentajeAutomatico Float           @default(0)
  notaAutomatica      Float            @default(0)
  notaFinal           Float            @default(0)
  modificadaPorDocente Boolean         @default(false)
  docenteIdModificacion Int?
  motivoModificacion  String?
  fechaModificacion   DateTime?
  nivelObtenido       NivelDificultad?
  nivelAlRendir       NivelDificultad?
  dificultadVariante  NivelDificultad?
  cantidadPreguntas   Int?
  especificacionAdaptativa Json?
  preguntasAsignadas  Json?
  varianteEvaluacionId Int?
  estado              EstadoIntento    @default(EN_PROGRESO)
  retroalimentacionIA Json?

  estudianteId Int
  estudiante   Usuario @relation(fields: [estudianteId], references: [id])

  evaluacionId Int
  evaluacion   Evaluacion @relation(fields: [evaluacionId], references: [id], onDelete: Cascade)

  docenteModificacion Usuario? @relation("CalificacionModificada", fields: [docenteIdModificacion], references: [id], onDelete: SetNull)

  varianteEvaluacion VarianteEvaluacion? @relation(fields: [varianteEvaluacionId], references: [id], onDelete: SetNull)

  respuestas         RespuestaEstudiante[]
  historialProgreso HistorialProgreso[]

  @@unique([estudianteId, evaluacionId])
  @@index([varianteEvaluacionId])
}

model RespuestaEstudiante {
  id                Int     @id @default(autoincrement())
  respuestaTexto    String?
  esCorrecta        Boolean @default(false)
  puntajeObtenido   Float   @default(0)
  retroalimentacion String?

  intentoId Int
  intento   IntentoEvaluacion @relation(fields: [intentoId], references: [id], onDelete: Cascade)

  preguntaId Int
  pregunta   Pregunta @relation(fields: [preguntaId], references: [id], onDelete: Cascade)

  alternativaId Int?
  alternativa   Alternativa? @relation(fields: [alternativaId], references: [id])

  @@unique([intentoId, preguntaId])
}

model ProgresoEstudiante {
  id                   Int             @id @default(autoincrement())
  tema                 String
  nivelActual          NivelDificultad @default(BASICO)
  porcentajeDominio    Float           @default(0)
  cantidadEvaluaciones Int             @default(0)
  recomendaciones      String?
  ultimaActualizacion  DateTime        @updatedAt

  estudianteId Int
  estudiante   Usuario @relation(fields: [estudianteId], references: [id])

  cursoId Int
  curso   Curso @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  asignacionCursoId Int?
  asignacionCurso   AsignacionCurso? @relation(fields: [asignacionCursoId], references: [id], onDelete: Restrict)

  temaCurricularId Int?
  temaCurricular   TemaCurricular? @relation(fields: [temaCurricularId], references: [id], onDelete: SetNull)

  @@unique([estudianteId, cursoId, tema])
  @@index([asignacionCursoId, estudianteId])
  @@index([temaCurricularId])
}

model HistorialProgreso {
  id                    Int              @id @default(autoincrement())
  tema                  String
  porcentaje            Float
  nota                  Float
  nivelAntes            NivelDificultad
  nivelDespues          NivelDificultad
  dificultadEvaluacion  NivelDificultad
  cantidadPreguntas     Int
  respuestasCorrectas   Int
  respuestasIncorrectas Int
  fecha                 DateTime         @default(now())

  estudianteId Int
  estudiante   Usuario @relation(fields: [estudianteId], references: [id], onDelete: Restrict)

  asignacionCursoId Int
  asignacionCurso   AsignacionCurso @relation(fields: [asignacionCursoId], references: [id], onDelete: Restrict)

  temaCurricularId Int?
  temaCurricular   TemaCurricular? @relation(fields: [temaCurricularId], references: [id], onDelete: SetNull)

  subtemaCurricularId Int?
  subtemaCurricular   SubtemaCurricular? @relation(fields: [subtemaCurricularId], references: [id], onDelete: SetNull)

  evaluacionId Int
  evaluacion   Evaluacion @relation(fields: [evaluacionId], references: [id], onDelete: Restrict)

  intentoId Int
  intento   IntentoEvaluacion @relation(fields: [intentoId], references: [id], onDelete: Restrict)

  @@unique([intentoId, tema])
  @@index([estudianteId, asignacionCursoId, tema, fecha])
  @@index([evaluacionId])
  @@index([temaCurricularId, fecha])
}

model PracticaAdaptativa {
  id                Int                      @id @default(autoincrement())
  tema              String
  dificultad        NivelDificultad
  estado            EstadoPracticaAdaptativa @default(PENDIENTE)
  motivoResumen     Json
  cantidadPreguntas Int                      @default(5)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  estudianteId Int
  estudiante   Usuario @relation(fields: [estudianteId], references: [id])

  cursoId Int
  curso   Curso @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  evaluacionId Int        @unique
  evaluacion   Evaluacion @relation(fields: [evaluacionId], references: [id], onDelete: Cascade)
}

model PlanCurricular {
  id            Int                  @id @default(autoincrement())
  nombreArchivo String
  rutaArchivo   String
  periodo       PeriodoCurricular
  estado        EstadoPlanCurricular @default(BORRADOR)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  cursoId Int
  curso   Curso @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  unidades UnidadCurricular[]
}

model UnidadCurricular {
  id          Int      @id @default(autoincrement())
  titulo      String
  descripcion String?
  orden       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  planCurricularId Int
  planCurricular   PlanCurricular @relation(fields: [planCurricularId], references: [id], onDelete: Cascade)

  temas TemaCurricular[]
}

model TemaCurricular {
  id          Int                  @id @default(autoincrement())
  titulo      String
  descripcion String?
  orden       Int
  estado      EstadoTemaCurricular @default(PENDIENTE)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  unidadCurricularId Int
  unidadCurricular   UnidadCurricular @relation(fields: [unidadCurricularId], references: [id], onDelete: Cascade)

  subtemas          SubtemaCurricular[]
  evaluaciones      Evaluacion[]
  progresos         ProgresoEstudiante[]
  historialProgreso HistorialProgreso[]
}

model SubtemaCurricular {
  id          Int      @id @default(autoincrement())
  titulo      String
  descripcion String?
  orden       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  temaCurricularId Int
  temaCurricular   TemaCurricular @relation(fields: [temaCurricularId], references: [id], onDelete: Cascade)

  evaluaciones      Evaluacion[]
  historialProgreso HistorialProgreso[]
}
