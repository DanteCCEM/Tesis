FROM node:22-alpine

WORKDIR /app
RUN apk add --no-cache openssl

COPY package.json package-lock.json ./
RUN npm ci

COPY prisma ./prisma
COPY prisma.config.ts ./
COPY src ./src
COPY test ./test
COPY vitest.config.mjs ./

RUN npx prisma generate

CMD ["sh", "-lc", "npx prisma migrate deploy && npm test"]
